{
  "name": "retroweb-mcp",
  "version": "0.1.1",
  "description": "MCP server for excavating 1990s-2000s Japanese personal websites from web archives",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "retroweb-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts",
    "e2e": "pnpm build && tsx src/e2e.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "wayback",
    "web-archive",
    "geocities",
    "retro-web",
    "japanese",
    "claude-code"
  ],
  "author": "Kagayoi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1llum1n4t1s/Retroweb-MCP.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**/*",
    "skills/**/*",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
